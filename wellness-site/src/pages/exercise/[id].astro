---
import Base from '../../layouts/Base.astro';
import SourceNote from '../../components/SourceNote.astro';
import MedicalDisclaimer from '../../components/MedicalDisclaimer.astro';
import Affiliate from '../../components/Affiliate.astro';
import { loadExercises } from '../../lib/data.mjs';
import { calorieTable, caloriesBurned, TABLE_MINUTES } from '../../lib/exercise.mjs';

export function getStaticPaths() {
  return loadExercises().exercises.map((e) => ({ params: { id: e.id }, props: { exercise: e } }));
}

const { exercise } = Astro.props;
const { meta } = loadExercises();
const table = calorieTable(exercise.met);
const example = caloriesBurned(exercise.met, 60, 30);
---
<Base
  title={`${exercise.shortName} 소모 열량 (체중·시간별)`}
  description={`${exercise.name} 30분 소모 열량은 체중 60kg 기준 약 ${example}kcal입니다. 체중 50~90kg, 10~60분 기준 표로 정리했습니다.`}
>
  <h1>{exercise.name} 소모 열량</h1>
  <p>MET {exercise.met} 기준 추정치입니다. 체중 60kg인 사람이 30분 운동하면 약 <strong>{example}kcal</strong>를 소모합니다.</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>체중</th>{TABLE_MINUTES.map((m) => <th>{m}분</th>)}</tr></thead>
      <tbody>
        {table.map((row) => (
          <tr><td>{row.kg}kg</td>{row.values.map((v) => <td>{v.kcal} kcal</td>)}</tr>
        ))}
      </tbody>
    </table>
  </div>
  <section class="card">
    <h2>계산 방법</h2>
    <p>분당 소모 열량 = MET × 3.5 × 체중(kg) ÷ 200. MET은 가만히 앉아 있을 때 대비 운동 강도를 나타내는 값입니다. 실제 소모량은 나이, 체력, 운동 자세에 따라 달라집니다.</p>
  </section>
  <Affiliate group="exercise" />
  <SourceNote source={meta.source} sourceUrl={meta.sourceUrl} />
  <MedicalDisclaimer />
</Base>
